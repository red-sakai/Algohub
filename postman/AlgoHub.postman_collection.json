{
  "info": {
    "_postman_id": "f5ea5f64-b6bb-4c8e-8d9a-f2c3193fd90c",
    "name": "AlgoHub - Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default env toggles",
          "if (!pm.environment.get('baseUrl')) pm.environment.set('baseUrl', 'http://localhost:3000');",
          "if (!pm.environment.get('EXPECT_EXTERNAL_SERVICES')) pm.environment.set('EXPECT_EXTERNAL_SERVICES', 'false');",
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Socket.IO bootstrap (GET /api/socketio)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/socketio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "socketio"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 400 (already bootstrapped)', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public Media",
      "item": [
        {
          "name": "Audio tracks (GET /api/audio)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audio"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body is an array (possibly empty)', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(Array.isArray(body)).to.eql(true);",
                  "});",
                  "pm.test('If items exist, they match {title, src}', function () {",
                  "  const body = pm.response.json();",
                  "  if (!Array.isArray(body) || body.length === 0) return;",
                  "  const first = body[0];",
                  "  pm.expect(first).to.have.property('title');",
                  "  pm.expect(first.title).to.be.a('string');",
                  "  pm.expect(first).to.have.property('src');",
                  "  pm.expect(first.src).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Car radio tracks (GET /api/car-radio)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/car-radio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "car-radio"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
