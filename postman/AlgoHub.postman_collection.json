                  "  const first = body[0];",
                  "  pm.expect(first).to.have.property('title');",
                  "  pm.expect(first.title).to.be.a('string');",
                  "  pm.expect(first).to.have.property('src');",
                  "  pm.expect(first.src).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Analytics",
      "item": [
        {
          "name": "Student growth (GET /api/admin/student-growth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/student-growth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "student-growth"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/400/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 400, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: success schema OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('data');",
                  "    pm.expect(Array.isArray(body.data)).to.eql(true);",
                  "    pm.expect(body).to.have.property('meta');",
                  "    pm.expect(body.meta).to.have.property('totalStudents');",
                  "    pm.expect(body.meta.totalStudents).to.be.a('number');",
                  "  } else {",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Achievements gained (GET /api/admin/achievements-gained)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/achievements-gained",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "achievements-gained"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/400/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 400, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: success schema OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('data');",
                  "    pm.expect(Array.isArray(body.data)).to.eql(true);",
                  "    pm.expect(body).to.have.property('meta');",
