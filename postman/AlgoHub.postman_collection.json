                  "    pm.expect(body.meta.totalUnlocked).to.be.a('number');",
                  "  } else {",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "AI insight (GET /api/admin/ai-insight)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ai-insight",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "ai-insight"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: success schema OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('data');",
                  "    pm.expect(body.data).to.have.property('insight');",
                  "    pm.expect(body.data.insight).to.be.a('string');",
                  "    pm.expect(body.data).to.have.property('metrics');",
                  "  } else {",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Storage",
      "item": [
        {
          "name": "Latest image path (POST /api/storage/latest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"folder\": \"license_cards\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storage", "latest"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/400/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 400, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: {path: string|null} OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('path');",
                  "    if (body.path !== null) pm.expect(body.path).to.be.a('string');",
                  "  } else {",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload image (POST /api/storage/upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataUrl\": \"{{TEST_IMAGE_DATA_URL}}\",\n  \"folder\": \"integration_tests\",\n  \"makePublic\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storage", "upload"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/400/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 400, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: {path, publicUrl?} OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('path');",
                  "    pm.expect(body.path).to.be.a('string');",
                  "    pm.environment.set('uploadedPath', body.path);",
                  "  } else {",
                  "    pm.environment.set('uploadedPath', '');",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign uploaded image (POST /api/storage/sign)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"{{uploadedPath}}\",\n  \"expiresInSeconds\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/storage/sign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "storage", "sign"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectExternal = (pm.environment.get('EXPECT_EXTERNAL_SERVICES') || 'false').toLowerCase() === 'true';",
                  "const uploadedPath = pm.environment.get('uploadedPath') || '';",
                  "",
                  "pm.test('If external services expected, upload path must exist', function () {",
                  "  if (expectExternal) pm.expect(uploadedPath.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Status is 200 when external services enabled; otherwise 200/400/500 allowed', function () {",
                  "  if (expectExternal) pm.expect(pm.response.code).to.eql(200);",
                  "  else pm.expect([200, 400, 500]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response shape: {url} OR {error}', function () {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(body).to.have.property('url');",
                  "    pm.expect(body.url).to.be.a('string');",
                  "  } else {",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
